{
  "name": "bookbridge-monorepo",
  "version": "1.0.0",
  "description": "BookBridge - Responsive Multilingual Book Discovery & Reading Tracker Portal",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server:dev\" \"npm run client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "server:seed": "npm run seed --prefix server",
    "test:server": "npm run test --prefix server"
  },
  "keywords": [
    "bookbridge",
    "react",
    "vite",
    "nodejs",
    "express",
    "mongodb",
    "concurrently"
  ],
  "author": "BookBridge Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
