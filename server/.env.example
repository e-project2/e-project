PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bookbridge_db
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEFAULT_ADMIN_EMAIL=admin@bookbridge.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_READER_EMAIL=reader@bookbridge.com
DEFAULT_READER_PASSWORD=Reader@123456
DEFAULT_READER_USERNAME=reader_demo
